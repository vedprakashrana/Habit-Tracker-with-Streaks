# ========================================================
# HabitFlow — Habit Tracker with Streaks (.env.example)
# ========================================================

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:postgres@localhost:5432/habitflow?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habitflow?schema=public

# Authentication Secrets
JWT_SECRET=habitflow_super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Demo User Credentials (Used by seed script)
DEMO_USER_NAME="Alex Morgan"
DEMO_USER_EMAIL=demo@habitflow.app
DEMO_USER_PASSWORD=password123
DEMO_USER_TIMEZONE=UTC
